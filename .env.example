# Create this bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public HTTPS origin of this app, without a trailing slash.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Set this to a long random value. Telegram includes it with every webhook.
TELEGRAM_WEBHOOK_SECRET=

# Optional separate HMAC key for short-lived media URLs. Falls back to the bot token.
PLAYBACK_SIGNING_SECRET=

# Optional Telegram chat ID that receives sanitized in-app bug reports.
# Reports are always stored in SQLite even when this is left blank.
BUG_REPORT_CHAT_ID=

# Local SQLite file. Good for a personal/small single-server deployment.
DATABASE_PATH=./data/tunes.db

# Local browser preview only. Never used as an auth bypass in production.
DEV_TELEGRAM_ID=424242
NEXT_PUBLIC_DEMO_MODE=true
